    "test:engine": "node --experimental-strip-types scripts/engine-check.ts",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
