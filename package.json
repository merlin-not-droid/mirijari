{
  "name": "mirijari",
  "version": "0.1.0",
  "private": true,
  "description": "미리자리 — 내 키·취향·동행에 맞는 좌석을 예매 전에 미리 골라 주는 서비스",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data": "node --env-file-if-exists=.env.local scripts/fetch-data.mjs",
