# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. 세 키 모두 없어도 서비스는 동작합니다.

# [선택] 공연 목록 (콘서트·뮤지컬 이번 달~다다음 달) — KOPIS 공연예술통합전산망 Open API
# 발급: https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do (무료, 회원가입 후 신청)
KOPIS_API_KEY=

# [선택] 현재 상영작 (일별 박스오피스) — KOBIS 영화진흥위원회 Open API
# 발급: https://www.kobis.or.kr/kobisopenapi/homepg/main/main.do (무료)
KOBIS_API_KEY=

# [선택] AI 코멘트 + 예매 화면 캡처 인식 — Claude API
# 발급: https://platform.claude.com/
# 현재 보류: 광고 수입이 생기면 입력한다. 비워 두면 AI 기능만 꺼지고 나머지는 그대로 동작
ANTHROPIC_API_KEY=

# [선택] 사용할 Claude 모델 (기본 claude-opus-5-5). 비용을 낮추려면 claude-haiku-5-5
ANTHROPIC_MODEL=

# [선택] 광고 (Google AdSense). 게시자 ID(ca-pub-…)와 광고 단위 ID 3개
# 비워 두면 광고 영역이 표시되지 않는다. 자리만 보려면 주소 뒤에 ?ads=preview
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_HOME=
NEXT_PUBLIC_AD_SLOT_LIST=
NEXT_PUBLIC_AD_SLOT_RESULT=

# [선택] 검색 등록: 구글 서치 콘솔·네이버 서치어드바이저의 소유 확인 코드, 사이트 주소(자체 도메인 연결 시)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=
